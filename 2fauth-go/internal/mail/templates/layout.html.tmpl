<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
  <meta name="color-scheme" content="light">
  <title>{{.Title}}</title>
  <style>
    html,body { margin:0!important; padding:0!important; width:100%!important; }
    table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }
    a { text-underline-offset:4px; }
    @media only screen and (max-width:620px) {
      .email-pad { padding-left:24px!important; padding-right:24px!important; }
      .email-title { font-size:27px!important; line-height:36px!important; }
      .fact-label { display:block!important; width:auto!important; padding:14px 0 0!important; border-top:1px solid #dfe4ec!important; border-bottom:0!important; }
      .fact-value { display:block!important; padding:2px 0 14px!important; border-bottom:0!important; }
      .email-outer { padding:0 0 24px!important; }
    }
  </style>
</head>
<body style="margin:0;background:#eef1f5;color:#101727;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;-webkit-text-size-adjust:100%;">
  <div class="preheader" style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all;">{{.Pre}}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef1f5">
    <tr><td align="center" class="email-outer" style="padding:32px 0 40px;">
      {{.MSOOpen}}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width:640px;background:#ffffff;border-radius:14px;">
        <tr>
          <td class="email-pad" style="padding:26px 44px 22px;border-bottom:1px solid #dfe4ec;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
              <td width="30" height="30" align="center" bgcolor="#101727" style="width:30px;height:30px;background:#101727;border-radius:8px;color:#55e6c1;font-size:13px;line-height:30px;font-weight:700;letter-spacing:.3px;">2F</td>
              <td style="padding-left:10px;color:#101727;font-size:17px;line-height:30px;font-weight:700;">{{.App}}</td>
            </tr></table>
          </td>
        </tr>
        {{template "body" .}}
        <tr>
          <td class="email-pad" data-email-role="footer" style="padding:22px 44px 28px;border-top:1px solid #dfe4ec;color:#5b6780;font-size:13px;line-height:21px;">
            {{if .ZH}}这封邮件由 {{.App}} 自动发送，请勿直接回复。{{else}}Sent automatically by {{.App}}. Replies are not read.{{end}}<br>
            <a href="{{.Home}}" style="color:#5b6780;">{{.Home}}</a>
          </td>
        </tr>
      </table>
      {{.MSOClose}}
    </td></tr>
  </table>
</body>
</html>
{{define "button"}}<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#101727" style="background:#101727;border-radius:10px;"><a href="{{.URL}}" style="display:inline-block;padding:14px 28px;color:#ffffff;font-size:16px;line-height:22px;font-weight:600;text-decoration:none;">{{.Label}}</a></td></tr></table>{{end}}
{{define "fact"}}<tr>
  <td class="fact-label" width="132" valign="top" style="width:132px;padding:13px 16px 13px 0;border-bottom:1px solid #dfe4ec;color:#44506a;font-size:15px;line-height:24px;">{{.Label}}</td>
  <td class="fact-value" valign="top" style="padding:13px 0;border-bottom:1px solid #dfe4ec;color:#101727;font-size:16px;line-height:24px;font-weight:600;word-break:break-word;">{{.Value}}</td>
</tr>{{end}}
