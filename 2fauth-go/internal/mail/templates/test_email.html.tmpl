{{define "body"}}<tr>
  <td class="email-pad" style="padding:38px 44px 38px;">
    <h1 class="email-title" style="margin:0 0 14px;color:#101727;font-size:30px;line-height:40px;font-weight:700;">{{if .ZH}}SMTP 配置可以发信{{else}}Your SMTP settings can send mail{{end}}</h1>
    <p style="margin:0 0 20px;color:#101727;font-size:17px;line-height:30px;">{{if .ZH}}{{.V.AdminName}} 在管理面板发送了这封测试邮件。能看到它，说明 {{.App}} 已经可以发送密码重置和安全提醒。{{else}}{{.V.AdminName}} sent this test from the admin panel. Receiving it means {{.App}} can deliver password resets and security alerts.{{end}}</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #dfe4ec;">
      {{if .ZH}}{{template "fact" (fact "SMTP 服务器" .V.Server)}}{{template "fact" (fact "加密方式" .V.Encryption)}}{{template "fact" (fact "发送时间" .V.Time)}}{{else}}{{template "fact" (fact "SMTP server" .V.Server)}}{{template "fact" (fact "Encryption" .V.Encryption)}}{{template "fact" (fact "Sent at" .V.Time)}}{{end}}
    </table>
  </td>
</tr>{{end}}
