{{define "body"}}<tr>
  <td class="email-pad" style="padding:38px 44px 38px;">
    <h1 class="email-title" style="margin:0 0 14px;color:#101727;font-size:30px;line-height:40px;font-weight:700;">{{if .ZH}}密码已修改{{else}}Your password was changed{{end}}</h1>
    <p style="margin:0 0 20px;color:#101727;font-size:17px;line-height:30px;">{{if .ZH}}<strong>{{.V.Email}}</strong> 的密码已更新。其他已登录的设备已退出，个人访问令牌已失效，需要时请重新创建。{{else}}The password of <strong>{{.V.Email}}</strong> was updated. Your other devices were signed out and your personal access tokens were revoked; create new ones if you need them.{{end}}</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #dfe4ec;margin:0 0 24px;">
      {{if .ZH}}{{template "fact" (fact "时间" .V.Time)}}{{template "fact" (fact "IP 地址" .V.IP)}}{{else}}{{template "fact" (fact "Time" .V.Time)}}{{template "fact" (fact "IP address" .V.IP)}}{{end}}
    </table>
    <p style="margin:0 0 20px;color:#101727;font-size:16px;line-height:28px;"><strong>{{if .ZH}}不是你本人操作？{{else}}Wasn't you?{{end}}</strong> {{if .ZH}}请立即通过下面的入口重新设置密码。{{else}}Reset your password right away.{{end}}</p>
    {{if .ZH}}{{template "button" (btn .V.ResetURL "重新设置密码")}}{{else}}{{template "button" (btn .V.ResetURL "Reset my password")}}{{end}}
  </td>
</tr>{{end}}
