{{define "body"}}<tr>
  <td class="email-pad" style="padding:38px 44px 8px;">
    <h1 class="email-title" style="margin:0 0 16px;color:#101727;font-size:30px;line-height:40px;font-weight:700;">{{if .ZH}}重置 {{.App}} 密码{{else}}Reset your {{.App}} password{{end}}</h1>
    <p style="margin:0 0 28px;color:#101727;font-size:17px;line-height:30px;">{{if .ZH}}我们收到了为 <strong>{{.V.Email}}</strong> 重置密码的请求。{{else}}We received a request to reset the password of <strong>{{.V.Email}}</strong>.{{end}}</p>
    {{if .ZH}}{{template "button" (btn .V.ResetURL "设置新密码")}}{{else}}{{template "button" (btn .V.ResetURL "Set a new password")}}{{end}}
    <p style="margin:20px 0 0;color:#101727;font-size:16px;line-height:28px;">{{if .ZH}}链接 <strong>{{.V.ExpiresMinutes}} 分钟</strong>内有效，只能使用一次。设置新密码后，其他已登录的设备会退出，个人访问令牌也会失效。{{else}}The link works once, for <strong>{{.V.ExpiresMinutes}} minutes</strong>. Setting a new password signs out your other devices and revokes your personal access tokens.{{end}}</p>
  </td>
</tr>
<tr>
  <td class="email-pad" style="padding:26px 44px 38px;">
    <p style="margin:0 0 8px;color:#101727;font-size:16px;line-height:28px;"><strong>{{if .ZH}}不是你发起的？{{else}}Didn't ask for this?{{end}}</strong> {{if .ZH}}忽略这封邮件即可，你的密码不会改变。{{else}}Ignore this e-mail. Your password stays the same.{{end}}</p>
    <p style="margin:18px 0 4px;color:#44506a;font-size:15px;line-height:24px;">{{if .ZH}}按钮无法打开时，可以复制这个链接到浏览器：{{else}}If the button does not open, copy this link into your browser:{{end}}</p>
    <p style="margin:0;font-size:14px;line-height:22px;word-break:break-all;"><a href="{{.V.ResetURL}}" style="color:#101727;">{{.V.ResetURL}}</a></p>
  </td>
</tr>{{end}}
