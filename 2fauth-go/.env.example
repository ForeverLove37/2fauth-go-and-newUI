# 2FAuth (Go) — configuration
#
# Copy this file to .env and generate an application key with:
#   2fauth key:generate

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=2FAuth
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# Deployment in a sub-directory, e.g. "2fauth" for https://host/2fauth/
APP_SUBDIRECTORY=
SITE_OWNER=

# Encryption key used for sessions, OTP secrets and 2FAuth-compatible payloads.
# Must be 32 bytes, either "base64:<32 bytes encoded>" or a raw 32 character string.
APP_KEY=

# Directory containing the built front-end (the public/ folder of 2FAuth v9).
# Defaults to <working directory>/public
ASSETS_PATH=

# Directory of the built React panel (the dist/ folder of 2fauth-ui).
# Served at "/", while the Vue SPA stays reachable at "/legacy".
# Defaults to <APP_BASE_PATH>/ui; when empty or missing, "/" serves the Vue SPA.
UI_ASSETS_PATH=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite (default) | mysql | pgsql
DB_CONNECTION=sqlite
# Absolute path of the SQLite file; defaults to <working directory>/database/database.sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions & authentication
# ---------------------------------------------------------------------------
# 120 minutes of inactivity logs the user out (the SPA receives a 418)
SESSION_LIFETIME=120
SESSION_DRIVER=cookie
# Set to true when served over HTTPS behind a TLS terminator
SESSION_SECURE_COOKIE=false

# web-guard | reverse-proxy-guard
AUTHENTICATION_GUARD=web-guard
AUTH_PROXY_HEADER_FOR_USER=REMOTE_USER
AUTH_PROXY_HEADER_FOR_EMAIL=REMOTE_EMAIL
PROXY_LOGOUT_URL=
TRUSTED_PROXIES=

# Failed logins allowed per minute and per client
LOGIN_THROTTLE=5
# API requests allowed per minute
THROTTLE_API=60
# API requests allowed per minute during an import
THROTTLE_API_DURING_IMPORT=30

# Retention of the audit logs, in months
AUTHENTICATION_LOG_RETENTION=365
OTP_LOG_RETENTION=12

# ---------------------------------------------------------------------------
# WebAuthn (reserved: the endpoints currently answer 501, see docs/COMPATIBILITY.md)
# ---------------------------------------------------------------------------
WEBAUTHN_NAME=2FAuth
WEBAUTHN_ID=
WEBAUTHN_USER_VERIFICATION=preferred

# ---------------------------------------------------------------------------
# Mail (used for password reset and the "test email" button)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=2fauth@example.com
MAIL_FROM_NAME=2FAuth

# ---------------------------------------------------------------------------
# SSO (reserved: the socialite endpoints currently answer 501)
# ---------------------------------------------------------------------------
OPENID_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
CONTENT_SECURITY_POLICY=false
BLOCK_OPTAUTH_IMAGELINK_FETCHING=false
IS_DEMO_APP=false
IS_TESTING_APP=false
