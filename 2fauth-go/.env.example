# 2FAuth (Go) — configuration
#
# Copy this file to .env and generate an application key with:
#   2fauth key:generate

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=2FAuth
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
# Address to bind (LISTEN_ADDR, or SERVER_PORT / PORT for a port on every interface).
# Example: LISTEN_ADDR=192.168.1.237:8444
LISTEN_ADDR=:8000
APP_TIMEZONE=UTC
# Deployment in a sub-directory, e.g. "2fauth" for https://host/2fauth/
APP_SUBDIRECTORY=
SITE_OWNER=

# Encryption key of the OTP secrets (always encrypted at rest), sessions and stored
# passwords. Must be 32 bytes, either "base64:<32 bytes encoded>" or a raw 32 character
# string. Back it up with the database: without it the secrets cannot be read.
# `2fauth key:generate` refuses to replace an existing key unless given --force.
APP_KEY=

# Directory containing the built front-end (the public/ folder of 2FAuth v9).
# Defaults to <working directory>/public
ASSETS_PATH=

# Directory of the built React panel (the dist/ folder of 2fauth-ui).
# Served at "/", while the Vue SPA stays reachable at "/legacy".
# Defaults to <APP_BASE_PATH>/ui; when empty or missing, "/" serves the Vue SPA.
UI_ASSETS_PATH=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite (default) | mysql | pgsql
DB_CONNECTION=sqlite
# Absolute path of the SQLite file; defaults to <working directory>/database/database.sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
# TLS toward the database server. The default uses it when the server offers it;
# set verify-full (PostgreSQL) or true (MySQL) on a network you do not control.
DB_SSLMODE=prefer
DB_TLS=preferred

# ---------------------------------------------------------------------------
# Sessions & authentication
# ---------------------------------------------------------------------------
# 120 minutes of inactivity logs the user out (the SPA receives a 418)
SESSION_LIFETIME=120
# A session ends after this many minutes, whatever its activity (30 days)
SESSION_MAX_AGE=43200
SESSION_DRIVER=cookie
# Set to true when served over HTTPS behind a TLS terminator
SESSION_SECURE_COOKIE=false

# web-guard | reverse-proxy-guard
# reverse-proxy-guard signs users in from the headers below. It needs TRUSTED_PROXIES:
# only those peers are believed, and the proxy must strip these headers from clients.
AUTHENTICATION_GUARD=web-guard
AUTH_PROXY_HEADER_FOR_USER=REMOTE_USER
AUTH_PROXY_HEADER_FOR_EMAIL=REMOTE_EMAIL
PROXY_LOGOUT_URL=

# Reverse proxies allowed to set X-Forwarded-For: addresses or CIDR networks, comma
# separated. Empty means the header is ignored and the TCP peer is the client.
TRUSTED_PROXIES=

# Only these addresses or CIDR networks may connect at all, comma separated; others are
# dropped before TLS and HTTP. Empty means everyone. Behind a reverse proxy, this is the
# address of the proxy. Example: ALLOWED_CLIENT_IPS=192.168.1.118
ALLOWED_CLIENT_IPS=

# Serve HTTPS directly (both are required); otherwise run behind a TLS reverse proxy.
# With an https APP_URL cookies are marked Secure and HSTS is sent.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Failed logins allowed per minute and per client
LOGIN_THROTTLE=5
# API requests allowed per minute, per user or client address (0 disables the limit)
THROTTLE_API=300
# Imports allowed per minute, per user (0 disables the limit)
THROTTLE_API_DURING_IMPORT=30

# Retention of the audit logs, in days; older entries are deleted (0 keeps them)
AUTHENTICATION_LOG_RETENTION=365
OTP_LOG_RETENTION=365

# ---------------------------------------------------------------------------
# WebAuthn (reserved: the endpoints currently answer 501, see docs/COMPATIBILITY.md)
# ---------------------------------------------------------------------------
WEBAUTHN_NAME=2FAuth
WEBAUTHN_ID=
WEBAUTHN_USER_VERIFICATION=preferred

# ---------------------------------------------------------------------------
# Mail: password resets, address confirmations and security alerts
# ---------------------------------------------------------------------------
# These are defaults: an administrator can override them from the panel
# (Settings > E-mail) and the stored values, with an encrypted password, win.
# smtp | log (log means nothing is sent)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls: STARTTLS, refused if the server does not offer it (port 587)
# ssl: TLS from the first byte (port 465)
# none: clear text, for a local relay only
MAIL_ENCRYPTION=tls
# Check the certificate of the SMTP server. Only disable it for a private relay.
MAIL_VERIFY_TLS=true
MAIL_FROM_ADDRESS=2fauth@example.com
MAIL_FROM_NAME=2FAuth
# Language of the e-mails of users who did not choose one: zh-CN or en
MAIL_LOCALE=zh-CN

# ---------------------------------------------------------------------------
# SSO / OpenID Connect (OIDC)
# ---------------------------------------------------------------------------
# A single generic OpenID Connect provider (authorization code flow with PKCE),
# usable with Keycloak, Authentik, Auth0, Okta, Google, Microsoft Entra ID,
# GitLab and Authelia. The values below are deployment defaults: an administrator
# can override every one of them from the panel (or through /api/v1/sso/settings)
# and the stored values always win over this file.
#
# The redirect URI to declare at the provider is built from APP_URL:
#   <APP_URL>/socialite/callback/openid
#
# Master switch. Sign-in is only offered when it is on AND an issuer AND a
# client id are configured.
OIDC_ENABLED=false
# Issuer identifier of the provider, e.g.
#   Keycloak : https://keycloak.example.com/realms/main
#   Authentik: https://authentik.example.com/application/o/2fauth/
#   Google   : https://accounts.google.com
#   Entra ID : https://login.microsoftonline.com/<tenant>/v2.0
# The discovery document is read from <issuer>/.well-known/openid-configuration,
# with a fallback to <issuer>/.well-known/oauth-authorization-server.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Client secret. The administrator UI keeps it encrypted in the database; a value
# set here (or through OPENID_CLIENT_SECRET, the 2FAuth v9 name) is the plain
# default used while no secret is stored.
OIDC_CLIENT_SECRET=
# Space separated scopes requested at the provider.
OIDC_SCOPES="openid profile email"
# Label of the sign-in button shown on the login screen.
OIDC_BUTTON_LABEL="Sign in with SSO"
# Create a local account the first time an unknown SSO user signs in (still subject
# to the "disableRegistration" and "restrictRegistration" settings).
OIDC_AUTO_REGISTER=true
# Accept an address without email_verified=true. Only for providers that never send
# this claim: anyone able to choose their address there can become the matching user.
OIDC_TRUST_UNVERIFIED_EMAIL=false
# Send visitors straight to the provider instead of showing the login form.
OIDC_AUTO_REDIRECT=false

# Legacy name kept for .env files written for 2FAuth v9; prefer
# OIDC_CLIENT_SECRET. GitHub OAuth is not implemented.
OPENID_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Icon providers
# ---------------------------------------------------------------------------
# Default-icon lookups (POST /api/v1/icons/default) walk an ordered list of icon
# providers and keep the first usable answer. Both values below are only
# defaults: an administrator overrides them from the panel or through
# PUT /api/v1/icons/providers, and the stored values always win over this file.
#
# Comma separated provider ids, in lookup order. Known ids:
#   selfhst      selfh.st                     (SVG)
#   dashboard    Homarr dashboard-icons       (SVG)
#   simpleicons  Simple Icons                 (SVG)
#   walkx        walkxcode dashboard-icons    (SVG, legacy set)
#   lobehub      LobeHub icons                (SVG)
#   iconify      Iconify search               (SVG, last resort)
ICON_PROVIDERS=selfhst,dashboard,simpleicons,walkx,lobehub,iconify
# How many of the enabled providers are actually tried (1-6).
ICON_PROVIDER_MAX_TRIES=6

# ---------------------------------------------------------------------------
# Command line access (SSH)
# ---------------------------------------------------------------------------
# Address of the SSH service that hands out OTP codes to the keys registered in
# Settings > Security, for example ":2222". Empty disables the service.
# ALLOWED_CLIENT_IPS applies to it as well.
SSH_LISTEN_ADDR=
# Host key of that service, created on first start. Defaults to
# storage/ssh_host_ed25519_key in the application directory.
SSH_HOST_KEY_FILE=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
CONTENT_SECURITY_POLICY=true
BLOCK_OPTAUTH_IMAGELINK_FETCHING=true
IS_DEMO_APP=false
IS_TESTING_APP=false
